{
  "apiVersion": "perses.dev/v1alpha1",
  "kind": "PersesDashboard",
  "metadata": {
    "name": "conference-planner"
  },
  "spec": {
    "display": {
      "name": "Conference Planner",
      "description": "Plans, search backends, GitHub rate limit and HTTP RED for service conference-planner."
    },
    "duration": "3h",
    "refreshInterval": "1m",
    "variables": [],
    "panels": {
      "markdown": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "About"
          },
          "plugin": {
            "kind": "Markdown",
            "spec": {
              "text": "Custom metrics from `app/metrics.js` (meter `conference-planner`) plus the auto-instrumented `http.server.request.duration`. Plan outcome `rejected` = bad request (unknown conference, invalid options), not our failure. Source: `dash0/` in github.com/RH-98/cloud-native-hackathon-2026."
            }
          }
        }
      },
      "plan_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Plan rate by outcome",
            "description": "Plans per second: ok, error (our failure) and rejected (bad input)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (outcome) (rate({otel_metric_name=\"planner.plans\", otel_metric_type=\"sum\", service_name=\"conference-planner\"}[5m]))",
                    "seriesNameFormat": "{{outcome}}",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "plan_duration": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Plan duration p50 / p95",
            "description": "Time to build a plan (planner.plan.duration)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "seconds"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum(rate({otel_metric_name=\"planner.plan.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "p50",
                    "minStep": "1m"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate({otel_metric_name=\"planner.plan.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "p95",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "plan_duration_by_backend": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Plan p95 by search backend",
            "description": "Elasticsearch vs. the in-memory snapshot."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "seconds"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (search_backend) (rate({otel_metric_name=\"planner.plan.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "{{search_backend}}",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "backend_share": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Search backend share",
            "description": "Share of plans served by each search backend."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "bar",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                },
                "stack": "all"
              },
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (search_backend) (rate({otel_metric_name=\"planner.plans\", otel_metric_type=\"sum\", service_name=\"conference-planner\", outcome=\"ok\"}[5m])) / scalar(sum(rate({otel_metric_name=\"planner.plans\", otel_metric_type=\"sum\", service_name=\"conference-planner\", outcome=\"ok\"}[5m])))",
                    "seriesNameFormat": "{{search_backend}}",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "fallbacks": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Search fallbacks to snapshot",
            "description": "Plans served from the snapshot instead of Elasticsearch, by reason (es_error, no_credentials)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "bar",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (reason) (increase({otel_metric_name=\"planner.search.fallbacks\", otel_metric_type=\"sum\", service_name=\"conference-planner\"}[5m]))",
                    "seriesNameFormat": "{{reason}}",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "picks": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Picks per plan (p50 / p95)",
            "description": "Sessions picked per plan (planner.plan.picks)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum(rate({otel_metric_name=\"planner.plan.picks\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "p50",
                    "minStep": "1m"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate({otel_metric_name=\"planner.plan.picks\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "p95",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "search_latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Search latency p95 by index and fusion",
            "description": "planner.search.duration: sessions (rrf = ES retriever, js = fused in app, snapshot = in memory) and sponsors."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "seconds"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum by (index, fusion) (rate({otel_metric_name=\"planner.search.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "{{index}} / {{fusion}}",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "github_ratelimit": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GitHub rate limit remaining",
            "description": "Latest x-ratelimit-remaining from the GitHub API (github.ratelimit.remaining)."
          },
          "plugin": {
            "kind": "StatChart",
            "spec": {
              "calculation": "last-number",
              "format": {
                "unit": "decimal",
                "decimalPlaces": 0
              },
              "sparkline": {},
              "thresholds": {
                "mode": "absolute",
                "defaultColor": "#e5484d",
                "steps": [
                  {
                    "value": 100,
                    "color": "#f5a524"
                  },
                  {
                    "value": 500,
                    "color": "#30a46c"
                  }
                ]
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "min(last_over_time({otel_metric_name=\"github.ratelimit.remaining\", otel_metric_type=\"gauge\", service_name=\"conference-planner\"}[10m]))",
                    "seriesNameFormat": "",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "github_ratelimit_trend": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "GitHub rate limit over time",
            "description": "Below 500 the check rule degrades; at 0 profiles fall back to typed interests."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "min({otel_metric_name=\"github.ratelimit.remaining\", otel_metric_type=\"gauge\", service_name=\"conference-planner\"})",
                    "seriesNameFormat": "remaining",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "http_rate": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP request rate by status",
            "description": "Requests per second (auto-instrumented http.server.request.duration)."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "decimal"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "sum by (http_response_status_code) (histogram_count(rate({otel_metric_name=\"http.server.request.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "{{http_response_status_code}}",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "http_errors": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP error rate (5xx)",
            "description": "Share of requests answered with a 5xx status."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "percent-decimal"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "(sum(histogram_count(rate({otel_metric_name=\"http.server.request.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\", http_response_status_code=~\"5..\"}[5m]))) or vector(0)) / sum(histogram_count(rate({otel_metric_name=\"http.server.request.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "5xx share",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      },
      "http_latency": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "HTTP latency p50 / p95 / p99",
            "description": "Server-side request duration."
          },
          "plugin": {
            "kind": "TimeSeriesChart",
            "spec": {
              "visual": {
                "display": "line",
                "lineWidth": 1.5,
                "areaOpacity": 0.2,
                "palette": {
                  "mode": "auto"
                }
              },
              "yAxis": {
                "format": {
                  "unit": "seconds"
                },
                "min": 0
              },
              "legend": {
                "position": "bottom",
                "mode": "list"
              }
            }
          },
          "queries": [
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.5, sum(rate({otel_metric_name=\"http.server.request.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "p50",
                    "minStep": "1m"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.95, sum(rate({otel_metric_name=\"http.server.request.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "p95",
                    "minStep": "1m"
                  }
                }
              }
            },
            {
              "kind": "TimeSeriesQuery",
              "spec": {
                "plugin": {
                  "kind": "PrometheusTimeSeriesQuery",
                  "spec": {
                    "query": "histogram_quantile(0.99, sum(rate({otel_metric_name=\"http.server.request.duration\", otel_metric_type=\"histogram\", service_name=\"conference-planner\"}[5m])))",
                    "seriesNameFormat": "p99",
                    "minStep": "1m"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "layouts": [
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Plans",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 3,
              "content": {
                "$ref": "#/spec/panels/markdown"
              }
            },
            {
              "x": 0,
              "y": 3,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/plan_rate"
              }
            },
            {
              "x": 8,
              "y": 3,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/plan_duration"
              }
            },
            {
              "x": 16,
              "y": 3,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/plan_duration_by_backend"
              }
            },
            {
              "x": 0,
              "y": 11,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/picks"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "Search",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/backend_share"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/fallbacks"
              }
            },
            {
              "x": 16,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/search_latency"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "GitHub",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 6,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/github_ratelimit"
              }
            },
            {
              "x": 6,
              "y": 0,
              "width": 18,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/github_ratelimit_trend"
              }
            }
          ]
        }
      },
      {
        "kind": "Grid",
        "spec": {
          "display": {
            "title": "HTTP (conference-planner)",
            "collapse": {
              "open": true
            }
          },
          "items": [
            {
              "x": 0,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/http_rate"
              }
            },
            {
              "x": 8,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/http_errors"
              }
            },
            {
              "x": 16,
              "y": 0,
              "width": 8,
              "height": 8,
              "content": {
                "$ref": "#/spec/panels/http_latency"
              }
            }
          ]
        }
      }
    ]
  }
}
